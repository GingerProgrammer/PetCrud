@model IEnumerable<PetCrud.Models.Animal>

@{
    ViewData["Title"] = "Index";
}

<h1>𝒜𝓃𝒾𝓂𝒶𝒾𝓈</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Cadastrar</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Idade)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Raca)
            </th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Nome)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Idade)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Raca)
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdAnimal"
                       class="btn btn-warning">
                        Atualizar
                    </a>

                    <a asp-action="Details" asp-route-id="@item.IdAnimal"
                       class="btn btn-info">
                        Detalhes
                    </a>

                    <a asp-action="Delete" asp-route-id="@item.IdAnimal"
                       class="btn btn-danger">
                        Excluir
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>