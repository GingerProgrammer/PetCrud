@model PetCrud.Models.Animal

@{
    ViewData["Title"] = "Create";
}

<h1>𝒞𝒶𝒹𝒶𝓈𝓉𝓇𝒶𝓇</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Idade" class="control-label"></label>
                <input asp-for="Idade" class="form-control" />
                <span asp-validation-for="Idade" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Raca" class="control-label"></label>
                <input asp-for="Raca" class="form-control" />
                <span asp-validation-for="Raca" class="text-danger"></span>
            </div>
            <div id="mastrer">
            <div class="form-group" id="bola">

                <input type="submit" name="name" value="Cadastrar 🐾" class="btn btn-primary" />

                
         
                    <form asp-action="Create" method="post">

                        <a asp-action="Index" class="btn btn-secondary me-2">
                            Voltar
                        </a>
                    </form>

           
                </div>
            </div>
           

        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
