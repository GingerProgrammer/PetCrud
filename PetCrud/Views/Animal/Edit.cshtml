@model PetCrud.Models.Animal

@{
    ViewData["Title"] = "Edit";
}

<h1>ℰ𝒹𝒾𝓉𝒶𝓇</h1>


<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="IdAnimal" />
            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Idade" class="control-label"></label>
                <input asp-for="Idade" class="form-control" />
                <span asp-validation-for="Idade" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Raca" class="control-label"></label>
                <input asp-for="Raca" class="form-control" />
                <span asp-validation-for="Raca" class="text-danger"></span>
            </div>
           
        </form>
    </div>
</div>

<div>
    <div class="form-group d-inline">
        <input type="submit" value="Atualizar 🐾" class="btn btn-warning" />
    </div>

    <a asp-action="Index" class="btn btn-secondary voltar">
        Voltar 🐕
    </a>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
